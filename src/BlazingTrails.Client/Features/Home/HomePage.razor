@page "/"
@namespace BlazingTrails.Client.Features.Home
@inject HttpClient Http

<PageTitle>Blazing Trails</PageTitle>

@if (_trails == null)
{
    <p>Loading trails</p>
}
else
{
    <TrailDetails Trail="_selectedTrail"></TrailDetails>
    <TrailSearch></TrailSearch>
    <div class="grid">
        @foreach (var trail in _trails)
        {
            <TrailCard Trail="trail" OnSelected="HandleTrailSelected"/>
        }
    </div>
}

@code {
    private IEnumerable<Trail>? _trails;
    private Trail? _selectedTrail;
    const string URL_TRAILS = "trails/trail-data.json";
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _trails = await Http.GetFromJsonAsync<IEnumerable<Trail>>(URL_TRAILS);
            Console.WriteLine("Trails json loaded");
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"There was a problem loading trail data: {ex.Message}");
        }
    }

    private void HandleTrailSelected(Trail t) => _selectedTrail =t; 
}