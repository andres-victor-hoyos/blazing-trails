@inherits InputBase<int>

<div class="input-time">
    <div>
        <input class="form-control @CssClass" type="number" min="0" @onchange="SetHourValue" value="@_hours" />
        <label>Hours</label>
    </div>
    <div>
        <input class="form-control @CssClass" type="number" min="0" max=59 @onchange="SetMinutesValue" value="@_minutes"/>
        <labe>Minutes</labe>
    </div>
</div>

@code {
    private int _hours;
    private int _minutes;
    protected override bool TryParseValueFromString(string? value, out int result, out string validationErrorMessage)
    {
        throw new NotImplementedException();
    }

    protected override void OnParametersSet()
    {
        _hours = CurrentValue / 60;
        _minutes = CurrentValue % 60;

    }

    private void SetHourValue(ChangeEventArgs arg)
    {
        _hours = Convert.ToInt16(arg.Value);
        SetCurrentValue();
    }

    private void SetMinutesValue(ChangeEventArgs arg)
    {
        _minutes = Convert.ToInt16(arg.Value);
        SetCurrentValue();
    }

    private void SetCurrentValue()
    {
        CurrentValue = _hours * 60 + _minutes;
    }
}